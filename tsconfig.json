{
  // The browser modules, plus the two suites that run straight off this
  // source with Node's native TypeScript support rather than through Vite:
  // tests/engine (pure puzzle logic) and tests/cv (the OpenCV artifact and
  // its loader). The page/DOM harness in tests/ui stays plain CommonJS
  // JavaScript and is deliberately out of scope here.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    // web/sudoku/*.ts import each other with an explicit ".ts" extension so
    // Node's ESM loader can run them unbundled in tests/engine; tsc otherwise
    // rejects that extension in an import specifier.
    "allowImportingTsExtensions": true,
    // Preact's JSX, not React's: the components in web/ are Preact components
    // written in React's dialect (see docs/adr/0004).
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "include": ["web", "vite.config.ts", "tests/engine", "tests/cv"]
}
