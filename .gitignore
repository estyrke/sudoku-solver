# Python is a tooling island now (tools/, see tools/requirements.txt); these
# three are what a venv for it leaves behind.
.venv/
__pycache__/
*.pyc
node_modules/
.vercel
.env*

# The front-end bundle is built, not committed: Vercel runs `npm run build` on
# deploy (vercel.json) and CI builds before the suites that import it.
static/dist/
