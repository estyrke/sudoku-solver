# Python is a tooling island now (tools/, see tools/requirements.txt); these
# three are what a venv for it leaves behind.
.venv/
__pycache__/
*.pyc
node_modules/
.vercel
.env*

# The build output, which is the whole deployable site: Vercel runs
# `npm run build` on deploy (vercel.json) and CI builds before the suites that
# read it. Nothing here is edited by hand.
dist/
