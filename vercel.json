{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/", "destination": "/static/index.html" },
    { "source": "/share", "destination": "/static/index.html" },
    { "source": "/manifest.webmanifest", "destination": "/static/manifest.webmanifest" },
    { "source": "/sw.js", "destination": "/static/sw.js" }
  ],
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Content-Type", "value": "text/javascript" }]
    }
  ]
}
